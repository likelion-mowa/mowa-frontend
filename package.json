{
  "name": "mowa",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "npm run strip-aps && expo run:ios --device",
    "ios:clean": "npm run prebuild && npm run ios",
    "prebuild": "expo prebuild --platform ios --clean && npm run strip-aps",
    "strip-aps": "node scripts/strip-aps-entitlement.mjs",
    "patch:jsi": "node scripts/patch-expo-jsi.mjs",
    "postinstall": "node scripts/patch-expo-jsi.mjs",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "serve:web": "expo serve",
    "deploy": "vercel deploy --prod",
    "deploy:preview": "vercel deploy",
    "lint": "expo lint"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.9",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.35.10",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3"
  }
}
