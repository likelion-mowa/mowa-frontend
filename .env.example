# 로컬 개발 전용. .env는 gitignore로 untracked — 실값 커밋 금지.
# Base URL은 /api/v1까지 포함한다. 배포(Vercel) 환경에는 절대 설정하지 않는다:
# mock은 로컬 전용이다 (mock/README.md). iOS 실기기는 Mac의 LAN IP를 쓴다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# 두 값이 모두 설정돼 있으면 감지 플로우가 토큰이 없을 때 자동 로그인한다.
# mock 계정 목록: mock/README.md.
EXPO_PUBLIC_MOCK_LOGIN_ID=
EXPO_PUBLIC_MOCK_PASSWORD=
